      "scopes": ["personal"]
    }
  ],
  "validDomains": ["REPLACE_WITH_DEPLOYED_HOSTNAME"],
  "webApplicationInfo": {
    "id": "REPLACE_WITH_ENTRA_APP_CLIENT_ID",
    "resource": "api://REPLACE_WITH_DEPLOYED_HOSTNAME/REPLACE_WITH_ENTRA_APP_CLIENT_ID"
