# App
APP_NAME=VectraFlow RAG API
ENVIRONMENT=development
SECRET_KEY=synapse_super_secret_key_12345
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://user:pass@postgres:5432/synapse

# Redis
REDIS_URL=redis://redis:6379/0

# Milvus
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=

# Object storage — Cloudinary (no AWS/S3 anywhere in this app)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Auth
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Embedding providers (defaults; per-KB overrides stored encrypted in DB)
# Default embedding provider is Cohere's hosted Embed API — set COHERE_API_KEY
# and you're done, no server to run.
# HUGGINGFACE_TEI_ENDPOINT is optional and only needed if you want to
# self-host TEI yourself (e.g. on EC2/ECS/Docker); leave it blank to use Cohere.
OPENAI_API_KEY=
COHERE_API_KEY=
VOYAGE_API_KEY=
HUGGINGFACE_TEI_ENDPOINT=

# LLM providers
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Reranker
COHERE_RERANK_API_KEY=
JINA_RERANK_API_KEY=
LOCAL_RERANKER_ENDPOINT=

# Vision
VISION_CAPTIONING_PROVIDER=anthropic

# Governance & PII
PII_DETECTION_ENABLED=true
DEFAULT_PII_ACTION=redact_before_send
AUDIT_LOG_RETENTION_DAYS=2555

# Agentic retrieval limits
AGENTIC_MAX_STEPS=4
AGENTIC_MAX_COST_USD=0.50
AGENTIC_MAX_WALL_CLOCK_SECONDS=60

# Resilience
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_WINDOW_SECONDS=60
INGESTION_PER_DOCUMENT_TIMEOUT_SECONDS=600
INGESTION_MAX_RETRY_ATTEMPTS=3
INGESTION_PER_KB_CONCURRENCY_LIMIT=10

# Versioning
DOCUMENT_VERSION_RETENTION_DAYS=90

# Free-tier guardrails
# Zilliz Cloud's free tier caps an account at 5 vector collections total —
# this caps knowledge base creation app-wide to match so ingestion doesn't
# start failing once the cap is hit.
MAX_KNOWLEDGE_BASES=5
# Lets any signed-in user delete any knowledge base (not just their own) so
# the shared free-tier slots can be freed up. Set to false once this app has
# per-user billing/quotas.
SHARED_KB_POOL_MODE=true
# Cloudinary's free plan is 25 credits/month shared across storage,
# bandwidth, and transformations (~1 credit per GB of any of them) — this
# defaults to a conservative slice of that pool. Uploads are rejected
# app-wide once total document storage would exceed this.
MAX_TOTAL_STORAGE_BYTES=3221225472

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Monitoring
SENTRY_DSN=
PROMETHEUS_ENABLED=true

# Encryption
ENCRYPTION_KEY=XGzHwE7xQc3O6Jk_z-oB7zF1HkGtR3dK8xW2J5V9YqQ=
